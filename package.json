{
  "name": "orbital",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "bash scripts/expo-dev-start.sh",
    "start:tunnel": "bash scripts/expo-dev-start.sh --tunnel",
    "start:tunnel:phone": "bash scripts/expo-tunnel-dev.sh",
    "start:web": "expo start --web",
    "web": "expo start --web",
    "build:web": "expo export -p web && mv dist/index.html dist/_app.html && node scripts/inject-dashboard-config.js",
    "doctor": "node scripts/doctor.js",
    "preflight": "node scripts/preflight.js",
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 100",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "audit": "npm audit --production",
    "ci:verify": "node scripts/ci-verify.js",
    "stress": "node scripts/stress.js",
    "stress:seed": "node scripts/seed-load-users.js",
    "citadel": "npm run ci:verify && npm run preflight && npm run stress",
    "cci:export": "node scripts/cci-export-pdf.js",
    "cci:verify": "node scripts/cci-verify-golden.js",
    "cci:render": "cd output && node render_ultra.js",
    "bundle:export": "npx tsx scripts/bundle-cci-export-pdf.ts",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "occ:build": "bash occ/scripts/run-occ-build.sh",
    "occ:preflight": "bash occ/scripts/run-occ-preflight.sh",
    "occ:maestro": "bash occ/scripts/run-maestro-smoke.sh",
    "occ:report": "npx tsx occ/scripts/generate-release-report.ts",
    "occ:e2e": "bash occ/scripts/run-maestro-smoke.sh && npx tsx occ/scripts/run-runtime-proof.ts",
    "occ:release": "bash occ/scripts/run-occ-release.sh",
    "occ:diagnose": "npx tsx occ/scripts/diagnose-maestro.ts",
    "ledger:webhook": "node scripts/orbital-ledger-webhook-serve.js",
    "vault:check": "node scripts/eas-vault-check.js",
    "eas-build-post-install": "node scripts/eas-vault-check.js",
    "occ:static:clinical": "OCC_FAIL_ON_CLINICAL=1 npx tsx occ/scripts/run-static-scan.ts",
    "warboard:start": "npm run warboard:start --prefix apps/warboard-next",
    "warboard:build": "npm run build --prefix apps/warboard-next",
    "warboard:prod": "npm run start --prefix apps/warboard-next",
    "elite:validate": "bash scripts/validate-conglomerate-elite.sh",
    "packages:verify": "npx tsx scripts/verify-orbital-packages.ts",
    "nexus:wire-db": "node scripts/wire-nexus-db-from-supabase.mjs",
    "nexus:smoke": "npx tsx scripts/smoke-nexus-conglomerate.ts",
    "n8n:install": "bash scripts/n8n/install-mac.sh",
    "n8n:pm2:start": "infra/orbital-n8n-runtime/node_modules/.bin/pm2 start conglomerate/n8n/ecosystem.config.cjs",
    "n8n:pm2:restart": "infra/orbital-n8n-runtime/node_modules/.bin/pm2 restart orbital-n8n",
    "n8n:pm2:stop": "infra/orbital-n8n-runtime/node_modules/.bin/pm2 stop orbital-n8n",
    "n8n:pm2:logs": "infra/orbital-n8n-runtime/node_modules/.bin/pm2 logs orbital-n8n",
    "n8n:verify": "node scripts/n8n/verify.mjs",
    "marketing": "node scripts/marketing-agent.js",
    "creative": "node scripts/marketing-agent.js campaign"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@revenuecat/purchases-js": "^1.24.1",
    "@sentry/react-native": "^7.8.0",
    "@shopify/react-native-skia": "2.2.12",
    "@supabase/supabase-js": "^2.90.0",
    "bip39": "^3.1.0",
    "buffer": "^6.0.3",
    "expo": "~54.0.30",
    "expo-apple-authentication": "^8.0.8",
    "expo-build-properties": "^1.0.10",
    "expo-constants": "~18.0.12",
    "expo-crypto": "~15.0.3",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "~19.0.6",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-print": "~14.0.3",
    "expo-router": "~6.0.21",
    "expo-secure-store": "^55.0.9",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "json5": "^2.2.3",
    "lucide-react-native": "^0.562.0",
    "orbital-background-save": "file:./modules/orbital-background-save",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^8.12.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "stripe": "^20.3.1",
    "vega": "^6.2.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.57.0",
    "@types/bip39": "^3.0.4",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vercel/node": "^5.6.6",
    "babel-preset-expo": "^54.0.9",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true
}